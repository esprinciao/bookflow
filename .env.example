# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side ONLY. Bypasses row-level security entirely.
# Never prefix this with NEXT_PUBLIC_ and never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — test mode (Phase 6)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL. http://localhost:3000 locally, the Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Direct Postgres connection, used only by scripts/migrate.sh. Server-side/local only.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Razorpay — test mode (Phase 6). Stripe is invite-only in India.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-key-secret
RAZORPAY_WEBHOOK_SECRET=a-secret-you-choose-when-creating-the-webhook
