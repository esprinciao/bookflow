# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side ONLY. Bypasses row-level security entirely.
# Never prefix this with NEXT_PUBLIC_ and never import it into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — test mode (Phase 6)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL. http://localhost:3000 locally, the Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
